[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://menus/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "EPOCH"
horizontal_alignment = 1

[node name="Play" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "Play"

[node name="Quit" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Center/Menu/Play" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Center/Menu/Quit" to="." method="_on_quit_pressed"]
